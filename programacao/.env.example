# Variáveis de ambiente do jogo. Copie este arquivo para .env.local e preencha (o .env.local não vai para o GitHub).
# Na Vercel, as mesmas variáveis vão em Settings → Environment Variables.
# Use só a chave PUBLICÁVEL (sb_publishable_...). A chave secreta nunca entra no jogo.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional, para o npm run conferir:configuracao: o endereço principal da Vercel (padrão: https://jogo-rpg-six.vercel.app)
# e o endereço de uma prévia (um ramo de teste), se quiser conferir a prévia também
ENDERECO_DA_VERCEL=
ENDERECO_DA_PREVIA=

# Só para o roteiro de testes das contas (npm run testar:contas, TEST-007), nunca no jogo nem na Vercel:
# duas contas de teste já confirmadas (documentacao/Supabase_passo_a_passo.md, passo D)
TESTE_CONTA_A_EMAIL=
TESTE_CONTA_A_SENHA=
TESTE_CONTA_B_EMAIL=
TESTE_CONTA_B_SENHA=
