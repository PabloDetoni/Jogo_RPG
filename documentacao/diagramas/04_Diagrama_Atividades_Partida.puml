@startuml Atividades_Partida
title Diagrama de Atividades — Partida (refeito pelo jogo de 26/11/2026)
' Cores parecidas com as da primeira versão do PNG
skinparam ActivityBackgroundColor #FFF6E0
skinparam ActivityBorderColor #7A6440
skinparam ActivityDiamondBackgroundColor #E4EEFA
skinparam ActivityDiamondBorderColor #3A6898
skinparam ArrowColor #444444
skinparam NoteBackgroundColor #FFFBE0
skinparam NoteBorderColor #C8B560
start
:Clicar em "Jogar" no Reino;
repeat
  repeat
    :Mostrar o mapa em ovo\n(Planalto no centro; Floresta aberta, os outros biomas bloqueados);
    switch (Destino?)
    case (Castelo)
      :Voltar ao Reino;
      stop
    case (Fazenda, Mina ou Lago)
      :Jogar uma rodada de 30 s do minijogo\n(3 rodadas por dia; a rodada conta ao começar);
      :Recursos na Mochila do Reino e XP dividido\nentre os personagens permanentes (não é partida);
      :Voltar ao Mapa;
    case (Floresta)
      :Caravana: escolher onde começar\n(o início de graça ou uma zona neutra paga;\nver o diagrama 06);
      :Preparação: escolher o Líder (um personagem permanente)\ne o que levar da Mochila do Reino (pelo peso);
      switch (Na Preparação?)
      case (Voltar)
        :Voltar ao Mapa (não conta como partida);
      case (Começar partida)
        :Reservar o preço da Caravana e os itens levados\n(só saem do Reino no fim);
      endswitch
    endswitch
  repeat while (A partida começou?) is (não) not (sim)
  :Tela de carregamento e a Floresta reiniciada\n(o grupo nasce na parada escolhida, sem mob perto);
  repeat
    :Jogo em andamento: andar (WASD), mirar e atacar (mouse),\nhabilidade (1), esquiva do Líder (Espaço);
    note right
      O progresso salvo não muda durante a partida:
      os ganhos entram só no fim (RF12).
      Se a página fechar no meio, nada é ganho
      nem cobrado (nem a Caravana).
    end note
    switch (O que o jogador fez ou o que aconteceu?)
    case (E perto de um item)
      :Pegar o item do chão para a mochila da partida;
    case (Tab)
      :Abrir a grade da mochila (sem pausar);\nE usa o item no Líder, R no aliado que mais precisa;
    case (Esc)
      if (Em combate?) then (não)
        :Pausar: Continuar, Configurações, Como jogar,\nVoltar ao Reino e o mapa inteiro (com os pontos de perigo);
      else (sim)
        :A pausa não abre;
      endif
    case (Personagem desmaiou)
      :Contagem de 30 s (a Ressurreição, ou um aliado\nparado perto dele com a área limpa, levanta);
      if (Levantado a tempo?) then (não)
        if (Era o Líder?) then (sim)
          :A partida termina: Líder não levantado;
        else (não)
          :A Pedra de Retorno leva o aliado ao Reino (perdido);
        endif
      endif
    case (Todos desmaiaram)
      :Cutscene: todos desmaiados;
    case (Q)
      if (Em combate?) then (não)
        :Contagem de 15 s para voltar ao Reino\n(volta a 15 s se entrar em combate; Q de novo cancela);
      else (sim)
        :O Q não começa;
      endif
    case (F)
      :Mostrar o custo da fuga;
      if (F de novo (confirmar)?) then (sim)
        :Contagem de 5 s, que não se cancela\n(se todos desmaiarem antes, vira Derrota);
      endif
    endswitch
  repeat while (A partida terminou?) is (não) not (sim)
  switch (Como terminou?)
  case (Retorno com Q)
    if (Nenhum desmaio e pontuação acima do mínimo?) then (sim)
      #palegreen:GRANDE VITÓRIA\ntaxa 0% e +10% de ouro e pontuação;
    else (não)
      #honeydew:VITÓRIA\ntaxa dos personagens perdidos;
    endif
  case (Fuga ou Líder não levantado)
    #lightyellow:RETORNO FORÇADO (amarelo);
  case (Todos desmaiaram)
    #mistyrose:DERROTA (com a cutscene);
  endswitch
  :Calcular a taxa sobre o ouro ganho (só o ouro; o XP nunca)\ne a pontuação;
  :Aplicar no progresso: ouro − taxa − preço da Caravana,\nXP, itens, descobertas, missão e conquistas;
  :Exibir o Resumo: resultado, motivo, ouro, taxa, Caravana,\nXP, pontuação e tempos;
  :Salvar (navegador e, com conta, Supabase com a versão do save);
repeat while (Jogar novamente?) is (sim) not (não)
:Voltar ao Reino;
stop
@enduml
